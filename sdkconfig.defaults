# Target selection is explicit: idf.py set-target esp32s3.
# TM-002 native TinyUSB mouse-only identity; CDC is disabled.
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y

# TM-006 staging: IMU/touch integration in the default USB application.
# ESP-NOW mode is dependency-held on TM-005B; no BLE, IP or RGB effects.
