# Default wired-only startup and mouse-only TinyUSB identity.
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
CONFIG_TILTMOUSE_OUTPUT_USB=y

# Select wireless in menuconfig and supply ignored local paired credentials.
# No infrastructure Wi-Fi/IP, Bluetooth or RGB effects in v0.1.
